# ====================================================================
# MEOW: Memory-Enhanced Operations & Workflow - Environment Template
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO GIT
# ====================================================================

# LLM Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2

# Vector Embeddings (Gemini or OpenAI)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# OPENAI_API_KEY=your_openai_api_key_here
# ENABLE_LOCAL_EMBEDDINGS=false

# Hindsight Memory Service (MEOW Experiential Memory)
# For local development: http://localhost:8888
# For Docker Compose: http://hindsight:8888
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_ENABLED=true
HINDSIGHT_TIMEOUT=30.0

# Hindsight Docker LLM Provider (Groq supported)
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-120b
HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=16384
HINDSIGHT_API_REFLECT_MAX_COMPLETION_TOKENS=16384

# MEOW Hindsight Feature Flags
MEOW_HINDSIGHT_ENABLED=true
MEOW_HINDSIGHT_SHADOW_MODE=true
MEOW_HINDSIGHT_CONTEXT_INJECTION=false

# Storage & Knowledge Base Paths
DB_PATH=data/support.db
CHROMA_RAG_DIR=data/chroma_rag
CHROMA_MEM0_DIR=data/chroma_mem0
KNOWLEDGE_BASE_DIR=knowledge_base

# Server and Dashboard Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

